{
  "version": "2.5.10",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "TunnelMaster",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "TunnelMaster",
    "externalBin": ["sidecar/tm-mihomo", "sidecar/tm-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "TunnelMaster",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "TunnelMaster",
  "identifier": "com.x1angyulu.TunnelMaster.verge",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["tunnelmaster-verge"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated", "usage-tray"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/icons/**",
            "$APPLOCALDATA/icons/**",
            "$RESOURCE/resources/**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
